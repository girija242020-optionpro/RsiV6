# REQUIRED — Dhan credentials
DHAN_CLIENT_ID=YOUR_DHAN_CLIENT_ID
DHAN_PIN=YOUR_6_DIGIT_DHAN_PIN
DHAN_TOTP_SECRET=YOUR_DHAN_TOTP_SECRET

# Server
PORT=10000

# Optional CORS. Use * for initial testing.
CORS_ORIGIN=*

# Live feed
FEED_REQUEST_CODE=8
RECONNECT_MS=3000
TOKEN_REFRESH_BUFFER_MS=300000

# Optional: supply a direct instrument master URL if Dhan changes its CSV URL.
# INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv

# Web Push (generated separately for you)
VAPID_PUBLIC_KEY=PASTE_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=PASTE_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:YOUR_EMAIL@gmail.com
